local function createDrawingESP(p)
    if p == LocalPlayer then return end
    local texts = {
        name = Drawing.new("Text"),
        info = Drawing.new("Text")
    }
    local tracer = Drawing.new("Line")
    
    for _, t in pairs(texts) do
        t.Visible = false
        t.Center = true
        t.Outline = true
        t.OutlineColor = Color3.fromRGB(0, 0, 0)
        t.Font = 2
        t.Size = 13
    end
    texts.name.Color = Color3.fromRGB(255, 255, 255)
    
    tracer.Visible = false
    tracer.Thickness = 1.5
    
    espCache[p] = {texts = texts, tracer = tracer}
end

