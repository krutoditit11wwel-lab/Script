    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local paddingLeft = Instance.new("UIPadding")
    paddingLeft.Parent = btn
    paddingLeft.PaddingLeft = UDim.new(0, 10)
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = btn
    
    local bindBtn = Instance.new("TextButton")
    bindBtn.Parent = btn
    bindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    bindBtn.Position = UDim2.new(1, -75, 0.5, -11)
    bindBtn.Size = UDim2.new(0, 65, 0, 22)
    bindBtn.Font = Enum.Font.GothamBold
    bindBtn.Text = "[" .. defaultKey.Name .. "]"
    bindBtn.TextColor3 = Color3.fromRGB(150, 150, 255)
    bindBtn.TextSize = 10
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)
    
    local state = false
    local currentKey = defaultKey
    local binding = false
    
    local function toggleState()
        state = not state
        btn.Text = text .. " [" .. (state and "ON" or "OFF") .. "]"
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(200, 200, 200)
        btn.BackgroundColor3 = state and Color3.fromRGB(20, 50, 30) or Color3.fromRGB(35, 35, 45)
        callback(state)
    end
    
    btn.MouseButton1Click:Connect(function()
        if not binding then toggleState() end
    end)
    
    bindBtn.MouseButton1Click:Connect(function()
        binding = true
        bindBtn.Text = "[...]"
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if binding and input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            bindBtn.Text = "[" .. currentKey.Name .. "]"
            binding = false
        elseif not gameProcessed and input.KeyCode == currentKey and not binding then
            toggleState()
        end
    end)
    
    return {set = toggleState, getState = function() return state end}
end

local function addSlider(text, min, max, default, callback)
    local container = Instance.new("Frame")
