local friendsList = {}

local function cleanName(str)
    if not str then return "" end
    str = str:gsub("^@", "")
    return str:lower():gsub("%s+", "")
end

local function isFriend(player)
    if not player then return false end
    local pName = cleanName(player.Name)
    local pDisplay = cleanName(player.DisplayName)
    for friend, _ in pairs(friendsList) do
        if friend == pName or friend == pDisplay then
            return true
        end
    end
    return false
end

local function formatTime(seconds)
    if seconds == 0 or seconds > 1000000000000 then return "Навсегда (Lifetime / Admin)" end
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    
    if days > 0 then
        return string.format("%dд %dч", days, hours)
    elseif hours > 0 then
        return string.format("%dч %dм", hours, minutes)
    else
        return string.format("%dм", minutes)
    end
end

